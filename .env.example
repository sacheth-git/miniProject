# Copy to .env and fill in. Every job-source key is optional:
# a missing key means that source is skipped with a warning.

ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=false
# Default (unset): SQLite file at backend/skillmatch.db
# DATABASE_URL=postgresql+psycopg://skillmatch:skillmatch@localhost:5432/skillmatch
CORS_ORIGINS=["http://localhost:5173"]

# Auth (generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_FALLBACK_MODEL=all-MiniLM-L6-v2

# Adzuna  https://developer.adzuna.com/  (free tier)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble  https://jooble.org/api/about  (free, key by email)
JOOBLE_KEY=

# JSearch via RapidAPI  https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch  (free tier)
# Covers LinkedIn / Indeed / Naukri listings through Google for Jobs.
RAPIDAPI_KEY=

# SerpApi Google Jobs  https://serpapi.com/  (optional alternative, free tier)
SERPAPI_KEY=

# SMTP for notifications (leave empty in dev: emails print to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@skillmatch.local
